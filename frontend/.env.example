# ── API ──
VITE_API_BASE_URL=http://localhost:4000/api

# ── Razorpay (public key only — safe for frontend) ──
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# ── reCAPTCHA v3 (site key — public, not the secret key) ──
VITE_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google OAuth (client ID — public) ──
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Firebase (public web config — restricted by Firebase Security Rules) ──
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Build (override for Capacitor APK builds) ──
# VITE_BASE=./
