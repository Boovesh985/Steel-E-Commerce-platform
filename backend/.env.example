# ── Database (two isolated PostgreSQL databases, SEPARATE users) ──
# IMPORTANT: Create two DB users with access ONLY to their own database.
# See scripts/init-db.sql for the setup SQL.
AUTH_DATABASE_URL=postgresql://amk_auth_user:auth_secret_pw@localhost:5432/amk_auth
CATALOG_DATABASE_URL=postgresql://amk_catalog_user:catalog_secret_pw@localhost:5432/amk_catalog

# ── JWT Secrets ──
# CRITICAL: Generate strong random secrets for production!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE-ME-generate-a-64-byte-hex-string
JWT_REFRESH_SECRET=CHANGE-ME-generate-a-different-64-byte-hex-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Razorpay (test mode) ──
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

# ── Admin Seed (the only way to create the first admin) ──
ADMIN_EMAIL=admin@amksteels.com
ADMIN_PASSWORD=change-this-in-production
ADMIN_NAME=AMK Admin
ADMIN_PHONE=9876543210

# ── Server ──
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ── Cloudinary (for product images) ──
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Email (Resend — https://resend.com, 3k emails/month free) ──
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=AMK Steels <noreply@yourdomain.com>
FRONTEND_URL=http://localhost:5173

# ── Firebase (Google Sign-In) ──
# Path to your Firebase Admin SDK service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=../steel-app-firebase-adminsdk.json

# ── Fast2SMS (SMS OTP — https://www.fast2sms.com) ──
FAST2SMS_API_KEY=your-fast2sms-api-key

# ── reCAPTCHA v3 (https://www.google.com/recaptcha/admin) ──
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key
